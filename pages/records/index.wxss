.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.loading, .empty {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty .muted {
  display: block;
  margin-bottom: 24rpx;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  margin-top: 8rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A202C;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-active {
  background: rgba(43, 108, 176, 0.12);
  color: #2B6CB0;
}

.status-cancel {
  background: #EDF2F7;
  color: #A0AEC0;
}

.record-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.cancel-btn {
  padding: 12rpx 36rpx;
  font-size: 26rpx;
}
