<view class="container">
  <view wx:if="{{loading}}" class="loading muted">加载中...</view>

  <view wx:elif="{{!openid}}" class="empty card">
    <view class="empty-title">未登录</view>
    <view class="muted">正在获取用户信息，请稍后重试。</view>
  </view>

  <view wx:elif="{{records.length === 0}}" class="empty card">
    <view class="empty-title">暂无报名记录</view>
    <view class="muted">还没有报名任何活动，快去首页看看吧。</view>
    <view class="btn-primary empty-btn" bindtap="onSignupAgain">去报名</view>
  </view>

  <view wx:else>
    <view wx:for="{{records}}" wx:key="_id" class="card record">
      <view class="record-head">
        <view class="record-title">{{item.activityTitle}}</view>
        <view class="status {{item.status === '已报名' ? 'status-active' : 'status-cancel'}}">{{item.status}}</view>
      </view>
      <view class="meta">
        <view class="meta-row"><text class="muted">姓名：</text><text>{{item.name}}</text></view>
        <view class="meta-row"><text class="muted">手机号：</text><text>{{item.phone}}</text></view>
        <view class="meta-row"><text class="muted">性别：</text><text>{{item.gender}}</text></view>
        <view class="meta-row" wx:if="{{item.remark}}"><text class="muted">备注：</text><text>{{item.remark}}</text></view>
        <view class="meta-row"><text class="muted">报名时间：</text><text>{{item.createdAtText}}</text></view>
      </view>
      <view wx:if="{{item.status === '已报名'}}" class="record-actions">
        <view class="btn-outline cancel-btn" bindtap="onCancel" data-id="{{item._id}}">取消报名</view>
      </view>
    </view>
  </view>
</view>
