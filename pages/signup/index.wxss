.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.signup-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: #2D3748;
}

.required {
  color: #E53E3E;
  margin-left: 4rpx;
}

.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.textarea {
  height: 160rpx;
}

.radio-group {
  display: flex;
}

.radio-item {
  margin-right: 48rpx;
  font-size: 28rpx;
  color: #2D3748;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding: 16rpx 24rpx;
  background: #F5F7FA;
}

.footer-btn {
  width: 100%;
}
