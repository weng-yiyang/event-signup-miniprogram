<view class="container">
  <view wx:if="{{!activityId && !activity}}" class="empty card">
    <view class="empty-title">未选择活动</view>
    <view class="muted">请先在首页选择活动后再报名。</view>
  </view>

  <block wx:else>
    <view class="card" wx:if="{{activity}}">
      <view class="title">{{activity.title}}</view>
      <view class="muted signup-sub">报名活动 · {{activity.startTimeText}} · {{activity.location}}</view>
    </view>

    <view class="card">
      <view class="form-item">
        <view class="label">姓名<text class="required">*</text></view>
        <input class="input" placeholder="请输入姓名" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="20" />
      </view>

      <view class="form-item">
        <view class="label">手机号<text class="required">*</text></view>
        <input class="input" type="number" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" maxlength="11" />
      </view>

      <view class="form-item">
        <view class="label">性别<text class="required">*</text></view>
        <radio-group class="radio-group" bindchange="onGenderChange">
          <label class="radio-item"><radio value="男" checked="{{form.gender === '男'}}" color="#2B6CB0" />男</label>
          <label class="radio-item"><radio value="女" checked="{{form.gender === '女'}}" color="#2B6CB0" />女</label>
        </radio-group>
      </view>

      <view class="form-item">
        <view class="label">备注</view>
        <textarea class="textarea" placeholder="选填，如有特殊需求请说明" value="{{form.remark}}" data-field="remark" bindinput="onInput" maxlength="200" />
      </view>
    </view>

    <view class="footer-bar">
      <view class="btn-primary footer-btn" bindtap="onSubmit">{{submitting ? '提交中...' : '提交报名'}}</view>
    </view>
  </block>
</view>
